# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Build output ----
backend/dist/
**/dist/
frontend/build/
**/build/web/
*.tsbuildinfo

# ---- Flutter / Dart ----
frontend/.dart_tool/
**/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
