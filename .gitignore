.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key

# ---- Runtime user uploads ----
backend/uploads/

# ---- Local academic archive (imported into backend/uploads) ----
first semester/

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- Logs & OS/editor cruft ----
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
