# CampusOS Backend — example environment
# Copy to backend/.env.development and fill in your own values.
# NEVER commit a file with real keys (it is git-ignored).

NODE_ENV=development
PORT=3005

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=campusos
DB_PASSWORD=change-me
DB_NAME=campusos
# DB_SCHEMA=public

# ---- Cache / Redis (optional) ----
# Leave REDIS_HOST unset OR set CACHE_STORE=memory to use in-memory cache.
REDIS_HOST=localhost
REDIS_PORT=6379
# CACHE_STORE=memory

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- CORS (comma-separated; scheme optional, bare hosts default to https) ----
CORS_ORIGINS=http://localhost:8082

# ---- AI providers (set at least one) ----
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RATE_LIMIT_RPM=60

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_RATE_LIMIT_RPM=120

# ---- Email verification / password reset (optional) ----
EMAIL_VERIFICATION_ENABLED=auto
EMAIL_DNS_CHECK=true
EMAIL_VERIFY_CODE_TTL_SECONDS=900
EMAIL_VERIFY_MAX_ATTEMPTS=5
EMAIL_CODE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_FROM_NAME=CampusOS
EMAIL_API_KEY=
EMAIL_API_URL=

# ---- Payments (optional) ----
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=

ECOCASH_BASE_URL=https://sandbox.ecocash.co.zw
ECOCASH_CLIENT_ID=
ECOCASH_CLIENT_SECRET=
ECOCASH_MERCHANT_ID=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20

# ---- Push / SMS (optional) ----
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.campusos.app
APNS_ENVIRONMENT=development
SMS_PROVIDER=twilio
SMS_SANDBOX=true
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# ---- Search (optional) ----
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
WS_CORS_ORIGINS=http://localhost:8082
